{
  "name": "kartwerkz",
  "private": true,
  "version": "0.1.0",
  "description": "Kartwerkz - self-hosted custom karting graphics ecommerce platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @kartwerkz/api prisma:migrate",
    "db:seed": "pnpm --filter @kartwerkz/api prisma:seed",
    "db:studio": "pnpm --filter @kartwerkz/api prisma:studio",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0"
  }
}
