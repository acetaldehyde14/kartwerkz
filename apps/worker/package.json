{
  "name": "@kartwerkz/worker",
  "private": true,
  "version": "0.1.0",
  "description": "Kartwerkz background worker — BullMQ job processors (send-email, scan-upload)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "start": "node -r dotenv/config dist/index.js",
    "start:prod": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"no unit tests in apps/worker — covered by apps/api\" && exit 0",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.1",
    "dotenv": "^18.0.6",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@kartwerkz/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
