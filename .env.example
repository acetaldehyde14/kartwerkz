# ---------------------------------------------------------------------------
# Kartwerkz environment configuration
# Copy to .env for local development: cp .env.example .env
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=kartwerkz
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=kartwerkz
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kartwerkz:change-me-dev-only@localhost:5432/kartwerkz?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_ROOT_USER=kartwerkz-admin
MINIO_ROOT_PASSWORD=change-me-dev-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kartwerkz-admin
S3_SECRET_ACCESS_KEY=change-me-dev-only
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=kartwerkz-uploads
S3_BUCKET_ARTWORK=kartwerkz-artwork

# --- API (NestJS) -------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
# Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-session-secret-please-rotate
SESSION_COOKIE_NAME=kw_session
GUEST_SESSION_COOKIE_NAME=kw_guest
CORS_ORIGIN=http://localhost:3000

# --- Storefront (Next.js) -----------------------------------------------------
STOREFRONT_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Stripe (test mode) -------------------------------------------------------
# Obtain from https://dashboard.stripe.com/test/apikeys — leave blank to run
# the dev payment adapter stub instead of calling Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel

# --- Email (SMTP) --------------------------------------------------------------
# Leave blank in development to use Mailpit (http://localhost:8025) via
# docker-compose instead of a real provider.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kartwerkz <no-reply@kartwerkz.local>"
MAILPIT_WEB_PORT=8025

# --- Currency / pricing ---------------------------------------------------------
DEFAULT_CURRENCY=SGD
# Development-only base price in minor units (SGD cents). Real commercial
# pricing must be set via admin settings before go-live — see docs/architecture.md.
DEV_BASE_PRICE_MINOR_UNITS=89900

# --- Nginx / public ports (production compose only) -----------------------------
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_DOMAIN=kartwerkz.example.com
